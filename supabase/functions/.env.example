# Set with:  supabase secrets set --env-file supabase/functions/.env
CRON_SECRET=change-me-to-a-long-random-string
SITE_URL=https://your-site.netlify.app
# Optional - email invitations to people who have no account yet (https://resend.com)
RESEND_API_KEY=
RESEND_FROM="Private Chat <invites@your-verified-domain.com>"
# Optional - SMS invitations (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+10000000000
