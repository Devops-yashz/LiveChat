# Frontend (public) variables. Only the ANON key goes here. NEVER put the service-role key in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Client-side upload limit in MB. Keep <= the server limits (bucket file_size_limit and app_settings.max_upload_mb).
VITE_MAX_UPLOAD_MB=10

# WebRTC. STUN is free; TURN is needed for strict NATs / mobile networks.
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
